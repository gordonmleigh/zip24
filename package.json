{
  "name": "zip24",
  "version": "0.1.8",
  "description": "A zip package for the modern age",
  "type": "module",
  "author": "Gordon Leigh",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gordonmleigh/zip24/issues"
  },
  "homepage": "https://github.com/gordonmleigh/zip24#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gordonmleigh/zip24.git"
  },
  "keywords": [
    "unzip",
    "zip",
    "archive",
    "stream"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./buffer": {
      "types": "./out/exports/buffer.d.ts",
      "default": "./out/exports/buffer.js"
    },
    "./entry": {
      "types": "./out/exports/entry.d.ts",
      "default": "./out/exports/entry.js"
    },
    "./raw/*": {
      "types": "./out/exports/raw/*.d.ts",
      "default": "./out/exports/raw/*.js"
    },
    "./reader": {
      "node": {
        "types": "./out/exports/node/reader.d.ts",
        "default": "./out/exports/node/reader.js"
      },
      "default": {
        "types": "./out/exports/reader.d.ts",
        "default": "./out/exports/reader.js"
      }
    },
    "./writer": {
      "node": {
        "types": "./out/exports/node/writer.d.ts",
        "default": "./out/exports/node/writer.js"
      },
      "default": {
        "types": "./out/exports/writer.d.ts",
        "default": "./out/exports/writer.js"
      }
    }
  },
  "scripts": {
    "build": "npm run clean && npm run test && npm run compile && npm run lint",
    "clean": "rm -rf lib/",
    "check": "tsc",
    "compile": "tsc -p tsconfig.build.json",
    "coverage": "c8 node --test-reporter=dot --test '**/*.test.ts'",
    "lint": "eslint",
    "release": "release-it -VV",
    "test": "c8 --100 node --test-reporter=spec --test '**/*.test.*'",
    "watch:compile": "tsc -w",
    "watch:coverage": "nodemon -e ts,js --watch '**/*.ts' --exec npm run coverage",
    "watch:test": "node --watch --test '**/*.test.*'"
  },
  "devDependencies": {
    "@propulsionworks/eslint-config": "^0.4.1",
    "@release-it/conventional-changelog": "^8.0.2",
    "@types/node": "^22.15.17",
    "c8": "^10.1.3",
    "eslint": "^9",
    "nodemon": "^3.1.2",
    "prettier": "^3.2.5",
    "release-it": "^17.7.0",
    "typescript": "^5.8"
  },
  "files": [
    "**/*.ts",
    "!**/*.test.ts",
    "out/",
    "package.*"
  ],
  "release-it": {
    "$schema": "https://unpkg.com/release-it/schema/release-it.json",
    "git": {
      "requireCommits": true,
      "requireBranch": "main"
    },
    "github": {
      "release": true
    },
    "hooks": {
      "commitMessage": "Chore: release v${version}"
    },
    "npm": {
      "publish": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "eslint"
        },
        "header": "# Changelog",
        "infile": "CHANGELOG.md",
        "strictSemVer": true
      }
    }
  }
}
