{
  "name": "zip24",
  "version": "0.1.7",
  "description": "A zip package for the modern age",
  "type": "module",
  "author": "Gordon Leigh",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gordonmleigh/zip24/issues"
  },
  "homepage": "https://github.com/gordonmleigh/zip24#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gordonmleigh/zip24.git"
  },
  "keywords": [
    "unzip",
    "zip",
    "archive",
    "stream"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./*": {
      "types": "./out/exports/*.d.ts",
      "default": "./out/exports/*.js"
    }
  },
  "imports": {
    "#package": {
      "node": "./package.js",
      "types": "./package.d.ts"
    }
  },
  "scripts": {
    "build": "npm run clean && npm run test && npm run compile && npm run lint",
    "clean": "rm -rf lib/",
    "compile": "tsc",
    "coverage": "c8 --src src/ --all -r text -r lcovonly node --test-reporter=dot --test '**/*.test.ts'",
    "lint": "eslint src",
    "release": "release-it -VV",
    "test": "c8 --100 --src src/ --all -r text -r lcovonly node --test-reporter=spec --enable-source-maps --test '**/*.test.*'",
    "watch:compile": "tsc -w",
    "watch:coverage": "nodemon -e ts,js --watch '**/*.ts' --exec npm run coverage",
    "watch:test": "node --watch --test '**/*.test.*'"
  },
  "devDependencies": {
    "@propulsionworks/eslint-config": "^0.4.1",
    "@release-it/conventional-changelog": "^8.0.2",
    "@types/node": "^22.15.17",
    "c8": "^10.1.3",
    "eslint": "^9",
    "nodemon": "^3.1.2",
    "prettier": "^3.2.5",
    "release-it": "^17.7.0",
    "typescript": "^5.8"
  },
  "files": [
    "src/",
    "lib/",
    "!*.test.*",
    "!**/test-util/"
  ],
  "release-it": {
    "$schema": "https://unpkg.com/release-it/schema/release-it.json",
    "git": {
      "requireCommits": true,
      "requireBranch": "main"
    },
    "github": {
      "release": true
    },
    "hooks": {
      "commitMessage": "Chore: release v${version}"
    },
    "npm": {
      "publish": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "eslint"
        },
        "header": "# Changelog",
        "infile": "CHANGELOG.md",
        "strictSemVer": true
      }
    }
  },
  "dependencies": {
    "crc-32": "^1.2.2"
  }
}
